---
import { getCreatorBySlug } from '@roolipeli/database';
import Error404Content from '../../components/Error404Content.astro';
import ReferenceList from '../../components/ReferenceList.svelte';
import JsonLd from '../../components/seo/JsonLd.astro';
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import '@roolipeli/design-system/components/card.css';
import '@roolipeli/design-system/components/data-list.css';
import '@roolipeli/design-system/components/section-heading.css';
import Breadcrumbs from '@roolipeli/design-system/components/Breadcrumbs.astro';
import '@roolipeli/design-system/components/breadcrumbs.css';

import { logDebug } from '@roolipeli/logger';
import { createSupabaseServerClient } from '../../lib/supabase';

const { slug } = Astro.params;

let creator;
if (slug) {
  try {
    const supabase = createSupabaseServerClient(Astro);
    creator = await getCreatorBySlug(supabase, slug);
  } catch (e) {
    logDebug(`Error fetching creator ${slug}:`, e instanceof Error ? e.message : String(e));
  }
}

if (!creator) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const t = useTranslations((Astro.currentLocale as 'fi' | 'sv' | 'en') || 'fi');
const title = creator ? `${creator.name} | Roolipeli.info` : t('error.404.title');

// Group products by game name; standalone products keyed as '__standalone__'
const STANDALONE_KEY = '__standalone__';
type ProductWithRole = {
  id: string;
  title: string;
  slug: string;
  product_type: string;
  year: number | null;
  lang: string;
  game: { id: string; name: string; slug: string } | null;
  role: string;
};

const groupedByGame = new Map<string, { gameSlug: string | null; products: ProductWithRole[] }>();

if (creator) {
  for (const pc of creator.products_creators ?? []) {
    const gameName = pc.product.game?.name ?? STANDALONE_KEY;
    const gameSlug = pc.product.game?.slug ?? null;
    if (!groupedByGame.has(gameName)) {
      groupedByGame.set(gameName, { gameSlug, products: [] });
    }
    groupedByGame.get(gameName)!.products.push({ ...pc.product, role: pc.role });
  }
}

// Named games sorted alphabetically, then standalone last
const sortedGroups = [...groupedByGame.entries()]
  .filter(([key]) => key !== STANDALONE_KEY)
  .sort(([a], [b]) => a.localeCompare(b, 'fi'));
const standaloneGroup = groupedByGame.get(STANDALONE_KEY);

const hasProducts = groupedByGame.size > 0;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('nav.creators.label'), href: '/tekijat' },
  ...(creator ? [{ label: creator.name }] : []),
];

// JSON-LD schema with sameAs from references
const siteUrl = Astro.url.origin;
const jsonLd = creator
  ? (() => {
      const schema: Record<string, unknown> = {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: creator.name,
        url: `${siteUrl}/tekijat/${creator.slug}`,
      };
      const sameAs = (creator.references || [])
        .filter(
          (ref: { reference_type: string }) =>
            ref.reference_type === 'official' || ref.reference_type === 'source',
        )
        .map((ref: { url: string }) => ref.url);
      if (sameAs.length > 0) {
        schema.sameAs = sameAs;
      }
      return schema;
    })()
  : null;
---

<Layout title={title} lang={Astro.currentLocale as "fi" | "en" | "sv"}>
    <>
        {
            creator ? (
                <>
                    <Breadcrumbs items={breadcrumbs} />

                    <h1>{creator.name}</h1>

                    <div class="creator-layout">
                        {hasProducts ? (
                            <section class="portfolio">
                                {sortedGroups.map(([gameName, group]) => (
                                    <div class="game-group">
                                        <div class="section-heading">
                                            <h2><a href={`/pelit/${group.gameSlug}`}>{gameName}</a></h2>
                                            <span class="section-heading-count">{group.products.length}</span>
                                        </div>
                                        <div class="data-list">
                                            {group.products.map((product) => (
                                                <div class="data-list-row">
                                                    <span class="data-list-cell">
                                                        <a href={`/tuotteet/${product.slug}`}>{product.title}</a>
                                                    </span>
                                                    <span class="data-list-cell data-list-muted">{product.role}</span>
                                                    <span class="data-list-cell data-list-muted">{product.year ?? ''}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                ))}
                                {standaloneGroup && (
                                    <div class="game-group">
                                        <div class="section-heading">
                                            <h2>{t('creator.projects.standalone')}</h2>
                                            <span class="section-heading-count">{standaloneGroup.products.length}</span>
                                        </div>
                                        <div class="data-list">
                                            {standaloneGroup.products.map((product) => (
                                                <div class="data-list-row">
                                                    <span class="data-list-cell">
                                                        <a href={`/tuotteet/${product.slug}`}>{product.title}</a>
                                                    </span>
                                                    <span class="data-list-cell data-list-muted">{product.role}</span>
                                                    <span class="data-list-cell data-list-muted">{product.year ?? ''}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </section>
                        ) : (
                            <p class="empty-state">{t('creator.projects.empty')}</p>
                        )}
                        {creator.references && creator.references.length > 0 && (
                            <section class="references card">
                                <span class="label">{t('creator.references.label')}</span>
                                <ReferenceList references={creator.references} />
                            </section>
                        )}
                    </div>
                    <JsonLd schema={jsonLd} />
                </>
            ) : (
                <Error404Content />
            )
        }
    </>
</Layout>

<style>
    .creator-layout {
        display: grid;
        gap: var(--kide-space-6);
    }

    .portfolio {
        display: grid;
        gap: var(--kide-space-6);
    }

    .empty-state {
        color: var(--kide-ink-muted);
        font-style: italic;
    }
</style>
