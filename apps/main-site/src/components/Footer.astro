---
import '@roolipeli/design-system/components/footer.css';
import { version } from '../../../../package.json';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: 'fi' | 'en' | 'sv';
}

const { lang = 'fi' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div class="site-footer__column">
                <h4 class="site-footer__heading">{t('footer.col1.heading')}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a href="/tietoa" class="site-footer__link">
                            {t('footer.versionLabel')} {version}
                        </a>
                    </li>
                </ul>
            </div>
            <div class="site-footer__column">
                <h4 class="site-footer__heading">{t('footer.col2.heading')}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a
                            href="https://github.com/Myrrys/roolipeli-info/blob/main/LICENSE"
                            class="site-footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {t('footer.mitLicense')}
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://kide-design-system.netlify.app/"
                            class="site-footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {t('footer.kideDs')}
                        </a>
                    </li>
                </ul>
            </div>
            <div class="site-footer__column">
                <h4 class="site-footer__heading">{t('footer.col3.heading')}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a
                            href="https://myrrys.com"
                            class="site-footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {t('footer.sponsor.myrrys')}
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="site-footer__colophon">
            <p>{t('footer.copyright')}</p>
        </div>
    </div>
</footer>
